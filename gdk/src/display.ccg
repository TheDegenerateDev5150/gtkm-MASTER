#include <vector>

#include <giomm/listmodel.h>
#include <gdkmm/applaunchcontext.h>
#include <gdkmm/clipboard.h>
#include <gdkmm/dmabufformats.h>
#include <gdkmm/glcontext.h>
#include <gdkmm/seat.h>
#include <gdkmm/monitor.h>
#include <gdkmm/surface.h>
#include <gdk/gdk.h>

namespace Gdk
{
  std::vector<KeymapKey> Display::map_keyval(guint keyval) const
  {
    GdkKeymapKey* c_keys = nullptr;
    int n_keys = 0;

    if(gdk_display_map_keyval(const_cast<GdkDisplay*>(gobj()), keyval, &c_keys, &n_keys))
    {
      std::vector<KeymapKey> keys;
      keys.reserve(n_keys);
      for(int i = 0; i < n_keys; ++i)
        keys.emplace_back(c_keys+i);
      g_free(c_keys);
      return keys;
    }
    else
      return {};
  }
} //namespace Gdk
